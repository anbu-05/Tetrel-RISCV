
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0

#
# Databases
#
database require waves -search {
	./waves.shm/waves.trn
	/home/userdata/23bvd0043/project/Tetrel-RISCV/SoC/workspace/waves.shm/waves.trn
}

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1010x600+208+122}] != ""} {
    window geometry "Waveform 1" 1010x600+208+122
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	simulator::top_tb.dut.clk
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.core_mem_addr[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.core_mem_instr
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.core_mem_rdata[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.core_mem_ready
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.core_mem_valid
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.core_mem_wdata[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.core_mem_wstrb[3:0]}
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.memory_mem_addr[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.memory_mem_instr
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.memory_mem_rdata[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.memory_mem_ready
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.memory_mem_valid
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.memory_mem_wdata[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.memory_mem_wstrb[3:0]}
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.reg_dat_di[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.reg_dat_do[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.reg_dat_re
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.reg_dat_wait
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.reg_dat_we
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.reg_div_di[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.reg_div_do[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::top_tb.dut.reg_div_we[3:0]}
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.resetn
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.ser_rx
	} ]
set id [waveform add -signals  {
	simulator::top_tb.dut.ser_tx
	} ]

waveform xview limits 0 2000ps

